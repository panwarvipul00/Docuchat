# Copy to .env.prod on the server and fill in. Never commit .env.prod.
# Hosts, CORS, CSRF and DATABASE_URL are derived from these in docker-compose.prod.yml.

# Your domain, no https:// (e.g. 140-238-12-34.sslip.io or docuchat.duckdns.org)
DOMAIN=

# Generate both with: python3 -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=
# Hex only, so it is safe inside the DATABASE_URL
POSTGRES_PASSWORD=

# Free tier: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_MODEL=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Max LLM tokens per user per UTC day (0 = unlimited). Protects your API quota.
DAILY_TOKEN_BUDGET=200000
